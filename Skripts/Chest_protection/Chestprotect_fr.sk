options:
    # ==================================================
    # Général
    # ==================================================
    prefix: &b[Server name] &8» &r

    # ==================================================
    # Permissions
    # ==================================================
    perm_protect: spiralyskript.chestprotect.protect
    perm_unprotect: spiralyskript.chestprotect.unprotect
    perm_chestadd: spiralyskript.chestprotect.chestadd
    perm_chestremove: spiralyskript.chestprotect.chestremove
    perm_chestsetting: spiralyskript.chestprotect.chestsetting
    perm_chestlist: spiralyskript.chestprotect.chestlist
    perm_cs_addplayer: spiralyskript.chestprotect.cs_addplayer
    perm_breakcontainer: spiralyskript.chestprotect.breakcontainer
    perm_chest: spiralyskript.chestprotect.chest
    perm_guide: spiralyskript.chestprotect.guide

    # ==================================================
    # Messages
    # ==================================================
    msg_place: "{@prefix}&aVous avez placé un conteneur. Utilisez &b/protect &aen le regardant pour le protéger."
    msg_place_cooldown: "{@prefix}&cVeuillez patienter avant de recevoir un nouveau message."
    msg_protect_success: "{@prefix}&aConteneur protégé avec succès ! Utilisez &b/unprotect &apour retirer la protection ou &b/chestsetting &apour consulter les paramètres du conteneur."
    msg_protect_already: "{@prefix}&cCe conteneur est déjà protégé."
    msg_protect_notowner: "{@prefix}&cVous ne pouvez protéger que vos propres conteneurs."
    msg_unprotect_success: "{@prefix}&aProtection retirée du conteneur."
    msg_unprotect_notprotected: "{@prefix}&eCe conteneur n'est pas protégé !"
    msg_unprotect_notowner: "{@prefix}&cVous ne pouvez retirer la protection que de vos propres conteneurs."
    msg_add_success: "{@prefix}&aVous avez autorisé &6%arg-1% &aà accéder à ce conteneur."
    msg_add_notprotected: "{@prefix}&cCe conteneur n'est pas protégé !"
    msg_add_notowner: "{@prefix}&cVous ne pouvez modifier que vos propres conteneurs."
    msg_remove_success: "{@prefix}&aVous avez retiré l'accès de &6%arg-1% &aà ce conteneur."
    msg_remove_notprotected: "{@prefix}&cCe conteneur n'est pas protégé !"
    msg_remove_notowner: "{@prefix}&cVous ne pouvez modifier que vos propres conteneurs."
    msg_setting_notvalid: "{@prefix}&cVous devez regarder un conteneur valide pour accéder à ses paramètres."
    msg_setting_notowner: "{@prefix}&cVous ne pouvez accéder qu'à vos propres conteneurs."
    msg_setting_notprotected: "{@prefix}&cCe conteneur n'est pas protégé. Utilisez &b/protect &cpour le protéger avant de gérer les paramètres."
    msg_freeze_notice: "{@prefix}&cVous avez été Freeze par la modération."
    msg_open_denied: "{@prefix}&cVous ne pouvez pas ouvrir ce conteneur, il est protégé et appartient à &6%{_ownerName}%&c."
    msg_break_denied: "{@prefix}&cVous ne pouvez pas détruire ce conteneur, il est protégé et appartient à &6%{_ownerName}%&c."
    msg_break_own: "{@prefix}&aVous avez détruit votre conteneur et sa protection a été supprimée."
    msg_place_near: "{@prefix}&cVous ne pouvez pas poser un coffre à proximité d'un conteneur protégé appartenant à &6%{_ownerName}%&c."
    msg_guide_title: "&e== Guide de protection des conteneurs =="
    msg_guide_protect: "&eProtection : &aVous ne pouvez pas ouvrir ou casser les conteneurs protégés d'autres joueurs."
    msg_guide_step1: "&aPlacez un coffre, shulker box, barrel ou hopper."
    msg_guide_protect_cmd: "&b/protect &a: Protéger le conteneur ciblé."
    msg_guide_unprotect_cmd: "&b/unprotect &a: Retirer la protection du conteneur."
    msg_guide_add_cmd: "&b/chestadd [Joueur] &a: Autoriser un joueur à accéder au conteneur."
    msg_guide_remove_cmd: "&b/chestremove [Joueur] &a: Retirer l'accès d'un joueur."
    msg_guide_setting_cmd: "&b/chestsetting &a: Ouvrir le menu de gestion du conteneur."
    msg_guide_list_cmd: "&b/chestlist &a: Voir la liste des joueurs autorisés."
    msg_guide_end: "&e===================================="

on place of chest or shulker box or barrel or hopper:
    set {chest-owner::%location of event-block%} to player's uuid
    if {chest-message-cooldown::%player's uuid%} is not set:
        send {@msg_place} to player
        set {chest-message-cooldown::%player's uuid%} to true
        wait 10 seconds
        delete {chest-message-cooldown::%player's uuid%}

command /protect:
    permission: {@perm_protect}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send {@msg_protect_notowner} to player
                stop
            if {chest-protected::%location of targeted block%} is set:
                send {@msg_protect_already} to player
                stop
            set {chest-protected::%location of targeted block%} to true
            send {@msg_protect_success} to player
        else:
            send "{@prefix}&cVous ne regardez pas un conteneur valide." to player

command /unprotect:
    permission: {@perm_unprotect}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send {@msg_unprotect_notowner} to player
                stop
            if {chest-protected::%location of targeted block%} is not set:
                send {@msg_unprotect_notprotected} to player
                stop
            delete {chest-protected::%location of targeted block%}
            delete {chest-access::%location of targeted block%::*}
            send {@msg_unprotect_success} to player
        else:
            send "{@prefix}&cVous ne regardez pas un conteneur valide." to player

command /chestadd <offline player>:
    permission: {@perm_chestadd}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send {@msg_add_notowner} to player
                stop
            if {chest-protected::%location of targeted block%} is not set:
                send {@msg_add_notprotected} to player
                stop
            add arg-1's uuid to {chest-access::%location of targeted block%::*}
            send {@msg_add_success} to player
        else:
            send "{@prefix}&cVous devez regarder un conteneur valide." to player

command /chestremove <offline player>:
    permission: {@perm_chestremove}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send {@msg_remove_notowner} to player
                stop
            if {chest-protected::%location of targeted block%} is not set:
                send {@msg_remove_notprotected} to player
                stop
            remove arg-1's uuid from {chest-access::%location of targeted block%::*}
            send {@msg_remove_success} to player
        else:
            send "{@prefix}&cVous devez regarder un conteneur valide." to player

command /chestsetting:
    permission: {@perm_chestsetting}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send {@msg_setting_notowner} to player
                stop
            if {chest-protected::%location of targeted block%} is not set:
                send {@msg_setting_notprotected} to player
                stop

            create a gui with virtual chest inventory with 3 rows named "&9Paramètres du conteneur":
                make gui slot (integers from 0 to 26) with gray stained glass pane named "&7"

                make gui slot 10 with player head named "&aAjouter un joueur" with lore "&7Cliquez pour donner%nl%&7l'accès à un joueur.":
                    execute player command "/cs_addplayer 1"

                make gui slot 12 with book named "&eListe des joueurs autorisés" with lore "&7Cliquez pour%nl%&7afficher la liste.":
                    execute player command "/chestlist 1"

                make gui slot 14 with barrier named "&cSupprimer la protection du conteneur" with lore "&7Cliquez pour retirer%nl%&7la protection.":
                    create a gui with virtual chest inventory with 3 rows named "&cConfirmer la suppression ?":
                        make gui slot (integers from 0 to 26) with gray stained glass pane named "&7"

                        make gui slot 15 with red concrete named "&cAnnuler" with lore "&7Cliquez pour annuler et%nl%&7revenir au menu précédent.":
                            close player's inventory
                            execute player command "/chestsetting"

                        make gui slot 11 with lime concrete named "&aConfirmer la suppression" with lore "&7Cliquez pour supprimer%nl%&7la protection du conteneur.":
                            delete {chest-protected::%location of targeted block%}
                            delete {chest-access::%location of targeted block%::*}
                            close player's inventory
                            send "{@prefix}&aLa protection du conteneur a été supprimée."
                    open last created gui to player

                make gui slot 16 with paper named "&eTutoriel manuel" with lore "&7Ajouter un joueur : &b/chestadd [Joueur]%nl%&7Retirer un joueur : &b/chestremove [Joueur]%nl%&7Paramètres : &b/chestsetting"

            open last created gui to player
        else:
            send {@msg_setting_notvalid} to player

command /chestlist [<number>]:
    permission: {@perm_chestlist}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send "{@prefix}&cVous ne pouvez consulter que vos propres conteneurs." to player
                stop
            if {chest-access::%location of targeted block%::*} is set:

                if arg-1 is set:
                    set {_page} to arg-1
                else:
                    set {_page} to 1

                set {_perPage} to 45
                set {_start} to ({_page} - 1) * {_perPage}
                set {_end} to {_start} + {_perPage} - 1

                create a gui with virtual chest inventory with 6 rows named "&eJoueurs autorisés - Page %{_page}%":
                    make gui slot (integers from 0 to 53) with gray stained glass pane named "&7"

                    set {_slot} to 0
                    set {_index} to 0
                    loop {chest-access::%location of targeted block%::*}:
                        if {_index} is between {_start} and {_end}:
                            set {_uuid} to loop-value
                            set {_name} to "Inconnu"
                            loop all offline players:
                                if uuid of loop-offline player = {_uuid}:
                                    set {_name} to loop-offline player
                                    stop loop

                            make gui slot {_slot} with skull of {_name} named "&a%{_name}%" with lore "&7Cliquez pour retirer l'accès":
                                remove {_uuid} from {chest-access::%location of targeted block%::*}
                                send "{@prefix}&cAccès retiré pour &6%{_name}%&c."
                                close player's inventory
                                execute player command "/chestlist %{_page}%"
                            add 1 to {_slot}
                        add 1 to {_index}

                    make gui slot 49 with barrier named "&cRetour" with lore "&7Revenir aux paramètres":
                        execute player command "/chestsetting"

                    if {_page} > 1:
                        make gui slot 45 with arrow named "&ePage précédente":
                            set {_prev} to {_page} - 1
                            execute player command "/chestlist %{_prev}%"

                    make gui slot 53 with arrow named "&ePage suivante":
                        set {_next} to {_page} + 1
                        execute player command "/chestlist %{_next}%"

                open last created gui to player

            else:
                send "{@prefix}&eAucun joueur autorisé pour ce conteneur." to player
        else:
            send "{@prefix}&cVous devez regarder un conteneur valide." to player

command /cs_addplayer [<number>]:
    permission: {@perm_cs_addplayer}
    trigger:
        if targeted block is chest or shulker box or barrel or hopper:
            if {chest-owner::%location of targeted block%} is not player's uuid:
                send "{@prefix}&cVous ne pouvez modifier que vos propres conteneurs." to player
                stop
            if {chest-protected::%location of targeted block%} is not set:
                send "{@prefix}&cCe conteneur n'est pas protégé !" to player
                stop

            if arg-1 is set:
                set {_page} to arg-1
            else:
                set {_page} to 1

            set {_perPage} to 45
            set {_start} to ({_page} - 1) * {_perPage}
            set {_end} to {_start} + {_perPage} - 1

            delete {_names::*}
            loop all offline players:
                add name of loop-offline player to {_names::*}
            sort {_names::*}

            create a gui with virtual chest inventory with 6 rows named "&aAjouter/Retirer un joueur - Page %{_page}%":
                make gui slot (integers from 0 to 53) with gray stained glass pane named "&7"

                set {_slot} to 0
                set {_index} to 0
                loop {_names::*}:
                    if {_index} is between {_start} and {_end}:
                        set {_name} to loop-value parsed as offline player
                        set {_uuid} to uuid of {_name}

                        if {chest-access::%location of targeted block%::*} contains {_uuid}:
                            make gui slot {_slot} with skull of {_name} named "&c%{_name}%" with lore "&7Déjà autorisé%nl%&eCliquez pour retirer":
                                remove {_uuid} from {chest-access::%location of targeted block%::*}
                                send "{@prefix}&cVous avez retiré l'accès de &6%{_name}%&c." to player
                                execute player command "/cs_addplayer %{_page}%"
                        else:
                            make gui slot {_slot} with player head named "&a%{_name}%" with lore "&7Pas encore autorisé%nl%&eCliquez pour ajouter":
                                add {_uuid} to {chest-access::%location of targeted block%::*}
                                send "{@prefix}&aVous avez autorisé &6%{_name}% &aà accéder au conteneur." to player
                                execute player command "/cs_addplayer %{_page}%"

                        add 1 to {_slot}
                    add 1 to {_index}

                make gui slot 49 with barrier named "&cRetour" with lore "&7Retour aux paramètres":
                    execute player command "/chestsetting"

                if {_page} > 1:
                    make gui slot 45 with arrow named "&ePage précédente":
                        set {_prev} to {_page} - 1
                        execute player command "/cs_addplayer %{_prev}%"

                make gui slot 53 with arrow named "&ePage suivante":
                    set {_next} to {_page} + 1
                    execute player command "/cs_addplayer %{_next}%"

            open last created gui to player
        else:
            send "{@prefix}&cVous devez regarder un conteneur valide." to player

on rightclick on chest or shulker box or barrel or hopper:
    if {chest-protected::%location of event-block%} is set:
        if {chest-owner::%location of event-block%} is not player's uuid:
            if {chest-access::%location of event-block%::*} does not contain player's uuid:
                cancel event
                set {_ownerUUID} to {chest-owner::%location of event-block%}
                set {_ownerName} to "Inconnu"
                loop all offline players:
                    if loop-offline player's uuid is {_ownerUUID}:
                        set {_ownerName} to loop-offline player
                        stop loop
                send {@msg_open_denied} to player

on break of chest or shulker box or barrel or hopper:
    if {chest-protected::%location of event-block%} is set:
        if {chest-owner::%location of event-block%} is not player's uuid:
            if player has permission {@perm_breakcontainer}:
                delete {chest-owner::%location of event-block%}
                delete {chest-protected::%location of event-block%}
                delete {chest-access::%location of event-block%::*}
            else:
                cancel event
                set {_ownerUUID} to {chest-owner::%location of event-block%}
                set {_ownerName} to "Inconnu"
                loop all offline players:
                    if loop-offline player's uuid is {_ownerUUID}:
                        set {_ownerName} to loop-offline player
                        stop loop
                send {@msg_break_denied} to player
        else:
            delete {chest-owner::%location of event-block%}
            delete {chest-protected::%location of event-block%}
            delete {chest-access::%location of event-block%::*}
            send {@msg_break_own} to player
    else:
        if {chest-owner::%location of event-block%} is player's uuid:
            delete {chest-owner::%location of event-block%}
        if player has permission {@perm_breakcontainer}:
            delete {chest-owner::%location of event-block%}

on place of chest or hopper:
    if player has permission {@perm_chest}:
        stop
    loop blocks in radius 1 around event-block:
        if loop-block is chest or shulker box or barrel or hopper:
            if {chest-protected::%location of loop-block%} is set:
                cancel event
                set {_ownerUUID} to {chest-owner::%location of loop-block%}
                set {_ownerName} to "Inconnu"
                loop all offline players:
                    if loop-offline player's uuid is {_ownerUUID}:
                        set {_ownerName} to loop-offline player
                        stop loop
                send {@msg_place_near} to player
                stop

command /chestprotect:
    permission: {@perm_guide}
    trigger:
        send ""
        send {@msg_guide_title}
        send {@msg_guide_protect}
        send {@msg_guide_step1}
        send {@msg_guide_protect_cmd}
        send {@msg_guide_unprotect_cmd}
        send {@msg_guide_add_cmd}
        send {@msg_guide_remove_cmd}
        send {@msg_guide_setting_cmd}
        send {@msg_guide_list_cmd}
        send {@msg_guide_end}
